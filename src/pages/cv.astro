---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="CV" sideBarActiveItemID="cv">
  <div class="mb-5"><div class="text-3xl w-full font-bold">Profile</div></div>
  <div class="mb-10 text-justify">
    Electronics Information Engineering graduate with experience in overseas FAE support, component data,
    product search, AI-assisted data extraction, and workflow automation. I enjoy work that connects
    engineering knowledge with data and practical software tools.
  </div>

  <div class="mb-5"><div class="text-3xl w-full font-bold">Education</div></div>
  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement title="B.Eng. in Electronic Information Engineering" subtitle="2020–2024 · Hanshan Normal University, Guangdong, China" />
  </div>

  <div class="mb-5"><div class="text-3xl w-full font-bold">Experience</div></div>
  <div class="time-line-container mb-10">
    <TimeLineElement title="Overseas FAE / Technical Customer Support" subtitle="2024–Present · Electronics distribution & PCBA">
      Technical pre-sales and after-sales support, component selection/replacement, datasheet-based issue analysis,
      customer communication, product information research, and cross-team coordination.
    </TimeLineElement>
    <TimeLineElement title="Component Data & Search Projects" subtitle="Product data / e-commerce">
      Worked on parameter architecture, category mapping, filter dictionaries, component replacement research,
      and search-related data improvements.
    </TimeLineElement>
    <TimeLineElement title="AI & Workflow Automation" subtitle="Internal tools and data workflows">
      Supported AI parameter extraction workflows and built lightweight automation for recurring FAE reporting and data tasks.
    </TimeLineElement>
  </div>

  <div class="mb-5"><div class="text-3xl w-full font-bold">Selected skills</div></div>
  <ul class="list-disc md:columns-3 columns-2 mx-6 mb-10">
    <li>Electronics / Components</li><li>FAE Support</li><li>Datasheet Analysis</li>
    <li>Component Selection</li><li>Product Data</li><li>Search / Filters</li>
    <li>AI Prompt Design</li><li>Data Extraction</li><li>Workflow Automation</li>
    <li>Excel</li><li>Python / Colab</li><li>Basic Java</li>
    <li>Technical Writing</li><li>English Customer Support</li><li>Git / GitHub</li>
  </ul>
</BaseLayout>
