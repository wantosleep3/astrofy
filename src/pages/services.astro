---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Capabilities" sideBarActiveItemID="services">
  <div class="mb-8">
    <div class="text-3xl w-full font-bold mb-3">Capabilities</div>
    <p class="text-lg">The kinds of technical problems I enjoy working on.</p>
  </div>

  <HorizontalCard title="Electronics FAE Support" img="/post_img.webp" desc="Datasheet-based technical analysis, component selection, replacement research, customer communication, and supplier follow-up." url="#" />
  <div class="divider my-0"></div>
  <HorizontalCard title="Product Data & Taxonomy" img="/post_img.webp" desc="Parameter architecture, category mapping, naming normalization, filter design, and product data quality." url="#" />
  <div class="divider my-0"></div>
  <HorizontalCard title="AI-assisted Data Workflows" img="/post_img.webp" desc="Prompt logic, parameter extraction, review flows, task management, and practical automation for repetitive data work." url="#" />
  <div class="divider my-0"></div>
  <HorizontalCard title="Search & Analytics" img="/post_img.webp" desc="Search behavior analysis, KPI tracking, structured experiments, and turning operational data into actionable improvements." url="#" />
</BaseLayout>
