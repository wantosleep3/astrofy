---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-8">
    <div class="text-3xl w-full font-bold mb-3">Projects</div>
    <p class="text-lg">A focused selection of personal builds and work case studies across electronics, product data, search, and AI-assisted workflows.</p>
    <p class="mt-3 text-sm opacity-70">Work case studies describe my own contribution at a high level. Internal systems, customer information, and confidential datasets are not published here.</p>
  </div>

  <div class="mb-4">
    <div class="text-xl font-bold">Personal build</div>
    <p class="text-sm opacity-70 mt-1">A hands-on prototype I designed and built outside my day-to-day role.</p>
  </div>
  <HorizontalCard
    title="AI BOM Copilot"
    img="/post_img.webp"
    desc="A component-sourcing workflow prototype exploring BOM normalization, supplier candidate search, and human review."
    url="/projects/ai-bom-copilot/"
    target="_self"
    badge="PERSONAL BUILD"
  />

  <div class="divider my-5"></div>
  <div class="mb-4">
    <div class="text-xl font-bold">Selected work case studies</div>
    <p class="text-sm opacity-70 mt-1">Real product and data work, presented with anonymized context and clearly scoped responsibilities.</p>
  </div>
  <HorizontalCard
    title="BOM Matching Accuracy Improvement"
    img="/post_img.webp"
    desc="Analyzed matching failures across 83 BOM files and supported requirements, metric definition, and acceptance testing."
    url="/projects/bom-matching-improvement/"
    target="_self"
    badge="BOM · QUALITY"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Parameter Architecture"
    img="/post_img.webp"
    desc="Standardizing component attributes, category-level parameter mapping, and reusable structures for product information and filters."
    url="/projects/component-data-architecture/"
    target="_self"
    badge="PRODUCT DATA"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Search Experience Redesign"
    img="/post_img.webp"
    desc="Improving search-result usability through filter scenarios, search logic clarification, and funnel measurement."
    url="/projects/search-experience/"
    target="_self"
    badge="SEARCH"
  />
</BaseLayout>
