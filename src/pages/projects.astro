---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-8">
    <div class="text-3xl w-full font-bold mb-3">Projects</div>
    <p class="text-lg">A selection of technical, data, AI, and automation work I've contributed to.</p>
  </div>

  <HorizontalCard
    title="AI Parameter Extraction Workflow"
    img="/post_img.webp"
    desc="Designed and supported an AI-assisted parameter extraction workflow covering task creation, prompt logic, priority content, category/reclassification/re-extraction, review and closing operations."
    url="#"
    badge="AI / DATA"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Search & Parameter Architecture"
    img="/post_img.webp"
    desc="Worked on electronic parameter architecture, filter dictionaries, category mapping, and search-related data improvements. A search redesign project was measured from 4.04% to 5.71% CVR."
    url="#"
    badge="SEARCH"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="BOM Matching & Component Replacement"
    img="/post_img.webp"
    desc="Supported component selection and replacement research, including large-scale BOM matching and investigation of alternative parts using supplier and distributor data."
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="DigiKey API / EDI Research"
    img="/post_img.webp"
    desc="Researched differences between an internal component API and DigiKey's digital integration capabilities, focusing on supported functions, fields, documentation, and conversion bottlenecks."
    url="#"
    badge="API"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="FAE Weekly Report Automation"
    img="/post_img.webp"
    desc="Built a repeatable workflow around weekly spreadsheets, work-order counts, project communication, and structured report generation."
    url="#"
    badge="AUTOMATION"
  />
</BaseLayout>
