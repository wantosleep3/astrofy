---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-8">
    <div class="text-3xl w-full font-bold mb-3">Projects</div>
    <p class="text-lg">Personal builds and selected, anonymized work case studies across electronics, product data, search, and AI-assisted workflows.</p>
    <p class="mt-3 text-sm opacity-70">Work case studies describe my contributions at a high level. Internal systems, customer information, and confidential datasets are not published here.</p>
  </div>

  <div class="mb-4">
    <div class="text-xl font-bold">Personal build</div>
  </div>
  <HorizontalCard
    title="AI BOM Copilot"
    img="/post_img.webp"
    desc="A prototype workspace for BOM normalization and component search, built to explore how structured workflows can make component review more efficient."
    url="/projects/ai-bom-copilot/"
    target="_self"
    badge="PERSONAL BUILD"
  />

  <div class="divider my-5"></div>
  <div class="mb-4">
    <div class="text-xl font-bold">Selected work case studies</div>
  </div>
  <HorizontalCard
    title="Component Parameter Architecture"
    img="/post_img.webp"
    desc="A product-data initiative to standardize electronic component attributes, align category-level parameters, and support more consistent filters and product information."
    url="/projects/component-data-architecture/"
    target="_self"
    badge="PRODUCT DATA"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Search Experience Redesign"
    img="/post_img.webp"
    desc="A search-result experience improvement spanning filter usability, query scenarios, search logic, and conversion-funnel measurement."
    url="/projects/search-experience/"
    target="_self"
    badge="SEARCH"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AI-assisted Parameter Extraction Workflow"
    img="/post_img.webp"
    desc="An anonymized workflow case study covering extraction task design, prompt iteration, review operations, and data-quality checks."
    url="/projects/component-data-architecture/"
    target="_self"
    badge="AI WORKFLOW"
  />
</BaseLayout>
