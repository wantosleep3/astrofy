---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Eris</div>
    <div class="text-3xl py-3 font-bold">Electronics · Product Data · Digital Product · AI</div>
    <div class="py-2">
      <text class="text-lg">
        I'm a female Electronics CSE / FAE working at the intersection of electronics, product data, and digital product optimization.
        With hands-on experience in electronic component distribution, I work beyond traditional technical support — helping improve how
        an electronics distributor organizes, presents, searches, and manages product information.
        My work spans component selection and technical analysis, product parameter architecture, category and taxonomy design, search and
        filter optimization, BOM and replacement research, and AI-assisted data workflows. I enjoy turning complex engineering requirements
        into structured data, practical product solutions, and more efficient digital experiences.
      </text>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="/projects">Explore my work</a>
      <a href="/cv" class="btn btn-outline">View CV</a>
      <a href="https://github.com/wantosleep3" target="_blank" class="btn btn-outline">GitHub</a>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">What I work on</div>
  </div>

  <div class="grid md:grid-cols-2 gap-4 mb-12">
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🔧 Electronics & FAE</div>
      <p>Component selection, replacement research, datasheet-based technical judgement, customer cases, and supplier communication.</p>
    </div>
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🔎 Product Data & Search</div>
      <p>Component parameters, category mapping, filter dictionaries, search quality, and structured product information.</p>
    </div>
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🤖 AI & Automation</div>
      <p>AI-assisted parameter extraction, review workflows, prompt design, and small tools that reduce repetitive work.</p>
    </div>
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">📊 Workflow & Analytics</div>
      <p>Turning messy operational data into measurable processes, reports, and practical internal tools.</p>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Selected projects</div>
  </div>

  <HorizontalCard
    title="AI Parameter Extraction"
    img="/post_img.webp"
    desc="An internal workflow for extracting and reviewing electronic component parameters with AI, including prompt logic, task management, and large-scale data processing."
    url="/projects"
    badge="AI"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Search & Filter Redesign"
    img="/post_img.webp"
    desc="Worked on component data architecture, parameter dictionaries, category mapping, and search improvements for an electronics e-commerce platform."
    url="/projects"
    badge="DATA"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="FAE Weekly Report Automation"
    img="/post_img.webp"
    desc="A lightweight workflow that turns weekly work-order and communication sheets into structured FAE reports."
    url="/projects"
    badge="AUTOMATION"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest notes</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
