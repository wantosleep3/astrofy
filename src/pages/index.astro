---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Eris</div>
    <div class="text-3xl py-3 font-bold">Electronics · Product Data · AI</div>
    <div class="py-2">
      <p class="text-lg">
        I work at the intersection of electronics, product data, and digital products.
        My experience spans component technical support, BOM matching improvement,
        product parameter architecture, search experience, and AI-assisted workflows.
        I also build small software tools to make complex or repetitive tasks easier.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="/projects">Explore projects</a>
      <a href="/cv" class="btn btn-outline">View CV</a>
      <a href="https://github.com/wantosleep3" target="_blank" rel="noreferrer" class="btn btn-outline">GitHub</a>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">What I work on</div>
  </div>

  <div class="grid md:grid-cols-2 gap-4 mb-12">
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🔧 Electronics & FAE</div>
      <p>Component selection, replacement research, datasheet-based technical analysis, and customer-facing engineering support.</p>
    </div>
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🔎 Product Data & Search</div>
      <p>Component parameters, category mapping, filter dictionaries, search quality, and structured product information.</p>
    </div>
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🤖 AI & Automation</div>
      <p>AI-assisted extraction, review workflows, prompt design, and small tools that reduce repetitive work.</p>
    </div>
    <div class="card bg-base-200 p-5">
      <div class="text-2xl mb-2">🧩 Digital Product Thinking</div>
      <p>Turning engineering and business requirements into clearer product experiences, data structures, and practical workflows.</p>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Selected projects</div>
    <p class="mb-4">A personal build alongside three anonymized work case studies. Each page explains the problem, my contribution, and the evidence behind the result.</p>
  </div>
  <HorizontalCard
    title="AI BOM Copilot"
    img="/post_img.webp"
    desc="A personal prototype exploring BOM normalization, supplier candidate search, and a reviewable component workflow."
    url="/projects/ai-bom-copilot/"
    target="_self"
    badge="PERSONAL BUILD"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="BOM Matching Accuracy Improvement"
    img="/post_img.webp"
    desc="Turning real-world matching failures into requirements, test cases, and measurable acceptance criteria."
    url="/projects/bom-matching-improvement/"
    target="_self"
    badge="WORK CASE STUDY"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Parameter Architecture"
    img="/post_img.webp"
    desc="An anonymized case study on standardizing component attributes and building a reusable product-data foundation."
    url="/projects/component-data-architecture/"
    target="_self"
    badge="WORK CASE STUDY"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Component Search Experience Redesign"
    img="/post_img.webp"
    desc="An anonymized case study focused on search-result usability, filter logic, and observed funnel changes."
    url="/projects/search-experience/"
    target="_self"
    badge="WORK CASE STUDY"
  />
</BaseLayout>
